:root{--bg:#090a12;--panel:#11131f;--panel2:#171927;--panel3:#1b1d2c;--border:#2b2d3e;--text:#f5f3fb;--sub:#a7a6b8;--muted:#77768b;--purple:#a87bff;--light-purple:#d5c3ff;--blue:#69c6ff;--pink:#ff6bb6;--green:#65e7ae;--orange:#ffb85c;--radius:20px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);font-family:'Segoe UI',Tahoma,Arial,sans-serif;color:var(--text);line-height:1.6;min-height:100vh}button,input,select{font:inherit}button{cursor:pointer}a{text-decoration:none;color:inherit}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--purple);outline-offset:3px}[hidden]{display:none!important}.ambient{position:fixed;width:600px;height:600px;border-radius:50%;filter:blur(150px);pointer-events:none;opacity:.15;z-index:-1}.ambient-a{top:-310px;right:5%;background:#7043bb}.ambient-b{top:500px;left:-300px;background:#293d9b}.topbar{min-height:88px;border-bottom:1px solid #222333;background:#090a12cf;backdrop-filter:blur(14px);display:flex;align-items:center;justify-content:space-between;padding:0 max(5vw,25px);gap:16px;position:sticky;top:0;z-index:8}.brand{display:flex;align-items:center;gap:12px}.brand-mark{height:42px;width:42px;display:grid;place-items:center;position:relative;border-radius:14px;background:linear-gradient(145deg,#b08aff,#6e46b3);font:900 22px Arial;color:#fff;box-shadow:0 0 24px #a879ff55}.brand-dot{position:absolute;font-size:7px;color:#ff669b;top:4px;left:6px}.brand strong{display:block;font:800 18px Arial;letter-spacing:2px}.brand small{display:block;font:500 9px Arial;letter-spacing:1.4px;color:#9895ac;margin-top:5px}.top-right{display:flex;align-items:center;gap:18px}.version{color:#8a869c;font:700 11px Arial;letter-spacing:1px}.pill{border:1px solid #3a344c;padding:8px 12px;border-radius:30px;color:#c5b5eb;font-size:12px;background:#201a2f}.status-dot,.dot-glow{display:inline-block;width:7px;height:7px;border-radius:50%;background:#a87bff;margin-left:8px;box-shadow:0 0 12px #a87bff}.pill.online{border-color:#2c5948;color:#89f1c6;background:#13271f}.pill.online .status-dot{background:#65e7ae;box-shadow:0 0 12px #65e7ae}.small-button{padding:10px 14px;border:1px solid var(--border);border-radius:10px;color:#e6e3ef;font-size:12px;background:#181926}.small-button:hover{border-color:#8e73bc}.shell{max-width:1460px;margin:auto;padding:26px clamp(17px,4.2vw,60px)}.hero{display:grid;grid-template-columns:1.15fr .85fr;min-height:360px;align-items:center;background:linear-gradient(115deg,#21172f 0%,#171426 55%,#141528 100%);border:1px solid #3b2c53;border-radius:26px;position:relative;overflow:hidden;padding:44px 54px}.hero:before{content:'';position:absolute;top:-120px;left:-110px;height:400px;width:400px;border:1px solid #ffffff12;border-radius:50%;box-shadow:0 0 0 65px #ffffff06,0 0 0 125px #ffffff04}.eyebrow,.overline{font:800 10px/1.4 Arial;letter-spacing:2px;color:#bba1fa}.eyebrow{font-size:12px;letter-spacing:.7px}.spark{margin-left:4px;color:#eabaff}.hero h1{font-size:clamp(30px,3.5vw,54px);line-height:1.3;letter-spacing:-1.3px;margin:17px 0 13px;font-weight:800;max-width:670px}.hero em{color:#c5a3ff;font-style:normal;text-shadow:0 0 36px #9b68fa55}.hero p{color:#bbb5ca;font-size:14px;max-width:440px;line-height:2;margin-bottom:25px}.hero-actions,.form-actions,.connection-actions{display:flex;gap:11px;flex-wrap:wrap}.button{border-radius:11px;padding:12px 18px;border:1px solid transparent;display:inline-flex;align-items:center;justify-content:center;gap:12px;font-size:13px;font-weight:750;transition:transform .2s ease,background .2s ease,box-shadow .2s ease;color:#fff}.button:hover{transform:translateY(-2px)}.button:active{transform:scale(.98)}.button.primary{background:linear-gradient(135deg,#a17afe,#794cdb);box-shadow:0 5px 20px #8253e32f}.button.primary:hover{box-shadow:0 8px 26px #a278fa5c}.button.subdued{background:#262239;border-color:#423b58}.button.subdued:hover{background:#332b48}.button.outline{background:#1a1c2a;border-color:#393a4c}.button.outline:hover{background:#24283a}.button.success{background:#1e493e;border-color:#33755b;color:#a1ffce}.button.accent{background:#602b53;border-color:#85456f;color:#ffc6e8}.button.full{width:100%;margin-top:9px}.hero-art{min-height:265px;position:relative;display:grid;place-items:center}.arena-symbol{width:214px;height:214px;border-radius:50%;display:grid;place-items:center;font:900 76px Arial;letter-spacing:-12px;padding-right:5px;position:relative;background:linear-gradient(130deg,#312142,#17182a);border:1px solid #8a61b761;box-shadow:0 0 0 20px #b477ff0b,0 0 0 45px #b477ff08,0 0 70px #8856cf33,inset 0 0 30px #a776ff16;transform:rotate(-10deg);color:#e6d7ff}.spark-mini{font-size:24px;position:absolute;top:32px;right:38px;color:#ceafff}.orb{position:absolute;color:#c6a2ff;filter:drop-shadow(0 0 12px #a575f8);animation:float 5s ease-in-out infinite}.orb-1{font-size:35px;top:12%;right:12%}.orb-2{font-size:27px;bottom:10%;left:14%;animation-delay:-2s}.floating-tag{position:absolute;font:800 12px Arial;letter-spacing:1px;border:1px solid #6e567e;background:#29203ee8;border-radius:11px;padding:11px 16px;box-shadow:0 8px 24px #08051044}.tag-top{left:5%;top:11%;transform:rotate(-6deg)}.tag-bottom{right:0;bottom:8%;transform:rotate(5deg)}.red-dot{color:#ff5b80}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px;margin:22px 0}.stat{background:#131522;border:1px solid #2a2b3a;border-radius:17px;padding:20px 22px;min-height:132px}.stat-label{font-size:12px;color:#a5a4b7;display:flex;justify-content:space-between}.stat-label span{color:#b99fff}.stat-number{font:800 33px Arial;margin:10px 0 3px;min-height:37px}.stat-number.small{font:800 22px 'Segoe UI',Arial;margin:12px 0 10px}.stat-foot{color:#747385;font-size:11px}.dashboard-grid{display:grid;grid-template-columns:minmax(0,1.68fr) minmax(315px,1fr);gap:20px;align-items:start;scroll-margin-top:112px}.panel{border:1px solid #2b2d3d;background:#131522;border-radius:22px;padding:24px}.main-panel{padding:30px}.section-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:26px}.section-heading h2{font-size:25px;margin:6px 0 3px;letter-spacing:-.6px}.section-heading p{margin:0;color:var(--muted);font-size:13px}.section-heading.compact{margin-bottom:17px}.section-heading.compact h2{font-size:19px;margin:5px 0}.section-icon{width:42px;height:42px;border-radius:12px;background:#25203a;border:1px solid #403258;display:grid;place-items:center;color:#bba0ff;font-size:23px}.modes{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:11px;margin-bottom:20px}.mode{min-height:125px;border:1px solid #343547;background:#191b2a;border-radius:16px;color:#e7e5ee;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:5px;transition:.2s}.mode:hover{border-color:#855eae;transform:translateY(-3px)}.mode.is-selected{border-color:#a47aff;background:linear-gradient(145deg,#2a2140,#201a32);box-shadow:inset 0 0 0 1px #9d70de32,0 6px 25px #7b45db1a}.mode-glyph{display:grid;place-items:center;width:40px;height:40px;font:800 22px Arial;border-radius:12px;margin-bottom:5px}.mode-glyph.violet{background:#3b295e;color:#d7bcff}.mode-glyph.blue{background:#183b53;color:#8fdaff}.mode-glyph.orange{background:#493820;color:#ffd293}.mode-glyph.pink{background:#48253f;color:#ffabda}.mode strong{font-size:13px}.mode small{font:700 10px Arial;letter-spacing:1.1px;color:#88849c}.form-card{border:1px solid #323344;background:#171926;padding:22px;border-radius:16px}.form-heading{display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:17px}.form-heading h3{margin:0;font-size:16px}.form-heading span{font-size:11px;color:#9d9aad}.field{display:flex;flex-direction:column;gap:7px;margin-bottom:15px}.field>span,.field-caption{font-size:12px;font-weight:650;color:#b9b7c7}.field input,.field select,.option-grid input{height:44px;background:#10121e;border:1px solid #373849;border-radius:9px;color:#f7f4fc;padding:0 13px;width:100%;outline:none;font-size:13px;transition:border-color .2s}.field input:focus,.field select:focus,.option-grid input:focus{border-color:#a678f1;box-shadow:0 0 0 3px #9256d416}.field input::placeholder{color:#67687b}.field select{color-scheme:dark}.option-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:8px 0 15px}.field-caption small{color:#77768c;font-size:11px;font-weight:400;margin-right:6px}.option-grid label{display:flex;align-items:center;gap:8px;background:#10121e;border:1px solid #373849;border-radius:9px;padding-right:11px}.option-grid label>span{color:#ad8bff;font:800 11px Arial;white-space:nowrap}.option-grid input{border:0;background:transparent;padding-right:0;min-width:0}.option-grid input:focus{box-shadow:none}.dual-fields{display:flex;gap:12px}.dual-fields .field{flex:1}.form-actions{border-top:1px solid #313242;padding-top:17px;margin-top:6px}.helper{padding:14px 16px;margin-top:14px;background:#252039;border:1px solid #443856;color:#c0afdf;border-radius:11px;font-size:12px}.preview-box{margin-top:22px;border-radius:17px;overflow:hidden;border:1px solid #353349;background:#0b0a17}.preview-head{display:flex;justify-content:space-between;align-items:center;padding:12px 17px;border-bottom:1px solid #2f2b3d;color:#cbc2e4;font-size:12px}.preview-head a{color:#b68eff}.preview-box iframe{width:100%;aspect-ratio:16/9;border:0;display:block;background:#0b0a17}.sidebar{display:flex;flex-direction:column;gap:19px}.sidebar .panel{padding:23px}.sidebar hr{border:0;border-top:1px solid #303140;margin:21px 0}.input-with-prefix{display:flex;align-items:center;border:1px solid #373849;border-radius:9px;background:#10121e;color:#ab93da}.input-with-prefix>span{padding:0 13px;font:800 17px Arial}.input-with-prefix input{border:0;direction:ltr;text-align:left;padding-left:0}.connection-actions .button:first-child{flex:1}.inline-message{background:#1e2031;border:1px solid #323648;border-radius:9px;padding:11px 12px;font-size:11px;color:#918fa9;line-height:1.8;margin-top:14px}.inline-message.valid{color:#86e6ac;border-color:#2d6147;background:#14281f}.section-desc{font-size:12px;color:#9693a9;line-height:1.9;margin:0 0 17px}.text-link{color:#bd95ff;background:none;border:0;font-size:11px}.text-link:hover{text-decoration:underline}.leaderboard{min-height:70px}.leader-row{display:flex;align-items:center;gap:13px;padding:12px 0;border-bottom:1px solid #292b39}.leader-row:last-child{border:0}.leader-row strong{font-size:12px;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.rank{font:800 13px Arial;color:#9293a7;width:30px}.rank.top-0{color:#ffdd83}.rank.top-1{color:#d4dff0}.rank.top-2{color:#d5a687}.score{font:700 11px Arial;color:#bb9aff;white-space:nowrap}.empty{color:#76758a;padding:16px 2px;text-align:center;font-size:12px}.activity-panel{margin-top:20px}.feed{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.feed-row{display:flex;align-items:center;gap:9px;background:#191b29;border-radius:10px;padding:12px;min-width:0}.chat-icon{width:25px;height:25px;border-radius:50%;display:grid;place-items:center;background:#38284d;color:#c7a6ff;font-size:11px;flex-shrink:0}.feed-row strong{font-size:11px;color:#bd9ef9;max-width:100px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.feed-row>span:nth-child(3){color:#dedbe8;font-size:12px;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.feed-row small{font-size:10px;color:#7c798b;white-space:nowrap}.stream-tag{color:#f77ba3;font:800 10px Arial;letter-spacing:1px}.stream-tag span{animation:blink 1.8s infinite}.footer{display:flex;justify-content:space-between;gap:15px;padding:26px 4px;color:#89879c;font-size:12px}.footer>span:first-child{font:800 12px Arial;letter-spacing:1px}.muted{color:#5c5b73}.toast{position:fixed;bottom:24px;left:24px;background:#29213c;border:1px solid #a278ed;padding:14px 20px;color:#f7f1ff;border-radius:13px;box-shadow:0 12px 50px #0008;max-width:min(390px,90vw);z-index:15;opacity:0;transform:translateY(16px);pointer-events:none;transition:.24s;font-size:13px}.toast.show{opacity:1;transform:translateY(0)}.toast.error{border-color:#df4e70;background:#3a1d2d}
/* OBS overlay, designed for a clean 16:9 browser source */
.overlay-page{background:#0b0a17;overflow:hidden;min-height:100vh}.overlay-page:before{content:'';position:fixed;width:75vw;height:75vw;max-width:1150px;max-height:1150px;left:15%;top:-56%;background:radial-gradient(circle,#5f2fa444,transparent 65%);z-index:0;pointer-events:none}.overlay-stage{width:100vw;height:100vh;min-height:390px;border:1px solid #3d285e;position:relative;display:flex;flex-direction:column;justify-content:space-between;padding:3.3vh 4vw;overflow:hidden;background:linear-gradient(115deg,#100e20b8,#0c0b19ba)}.overlay-stage:before,.overlay-stage:after{content:'';position:absolute;width:40vw;height:40vw;border:1px solid #b59aff1c;border-radius:50%;pointer-events:none}.overlay-stage:before{top:-28vw;left:-18vw}.overlay-stage:after{bottom:-30vw;right:-10vw}.overlay-top,.overlay-bottom{position:relative;display:flex;align-items:center;justify-content:space-between;gap:1.3vw;z-index:1}.overlay-logo{color:#c9adff;font:900 clamp(11px,1.5vw,27px) Arial;letter-spacing:2px}.overlay-live{font:800 clamp(8px,.86vw,18px) Arial;letter-spacing:2px;padding:.6em 1.3em;border:1px solid #9d426b;border-radius:100px;background:#3d1631;color:#ffa5bd}.overlay-live i{display:inline-block;width:.7em;height:.7em;border-radius:50%;background:#ff5f87;box-shadow:0 0 1em #ff5f87;margin-right:.6em}.overlay-center{text-align:center;position:relative;z-index:1;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:min(2vh,16px);min-height:0}.overlay-kicker{font:800 clamp(9px,1.25vw,24px) Arial;letter-spacing:3px;color:#b89cf7}.overlay-center h1{font-size:clamp(24px,4.3vw,83px);line-height:1.1;margin:0;color:#faf5ff;text-shadow:0 0 35px #a783f577}.overlay-center p{font-size:clamp(12px,2.25vw,48px);font-weight:700;color:#cfc8e3;line-height:1.5;margin:0;max-width:88%}.overlay-choices{display:grid;grid-template-columns:1fr 1fr;gap:1.15vw;width:80%;margin-top:1.4vh}.overlay-choices>div{padding:1.5vh 1.8vw;border:1px solid #685585;background:linear-gradient(110deg,#24203a,#191729);border-radius:1.2vw;color:#a77cff;text-align:right;font:900 clamp(12px,1.8vw,37px) Arial;display:flex;align-items:center;gap:1.6vw}.overlay-choices span{font-family:'Segoe UI',Tahoma,sans-serif;font-size:clamp(12px,2vw,40px);font-weight:700;color:#f4eefe}.overlay-hint{color:#aa92cc;font-weight:650;font-size:clamp(9px,1.26vw,25px);margin-top:.5vh}.overlay-bottom{padding-top:2vh;border-top:1px solid #6c517255;color:#cfc7dc;font-size:clamp(9px,1vw,19px)}.overlay-status{display:flex;align-items:center;gap:10px}.pulse{width:.8em;height:.8em;background:#a87bff;border-radius:50%;box-shadow:0 0 15px #a87bff;animation:blink 1.7s infinite}.overlay-standings{display:flex;gap:2vw;max-width:62%;overflow:hidden;white-space:nowrap}.overlay-standings span{overflow:hidden;text-overflow:ellipsis}.overlay-race{display:flex;flex-direction:column;gap:1vw;width:78%;margin-top:1.2vh}.racer{display:flex;align-items:center;gap:1.3vw;font-size:clamp(9px,1.5vw,30px)}.racer strong{width:24%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:right}.racer small{color:#ceafff}.race-track{flex:1;height:1.35vw;min-height:7px;background:#2a243f;border-radius:100px;overflow:hidden}.race-fill{height:100%;background:linear-gradient(90deg,#8a5cec,#e5afff);border-radius:100px;box-shadow:0 0 20px #a467ff;transition:width .35s}.overlay-wheel{display:flex;flex-direction:column;align-items:center;gap:1vh}.wheel-disc{height:min(19vh,140px);width:min(19vh,140px);border:1.5vw solid #674d92;box-shadow:0 0 0 1vw #8e56a524,0 0 50px #9566d54f;display:grid;place-items:center;border-radius:50%;font-size:clamp(40px,7vw,110px);color:#d9b5ff;animation:spin 14s linear infinite}.overlay-wheel>span{font-size:clamp(12px,1.8vw,33px);color:#cdb1ff}.winner-banner{position:absolute;inset:13% 13%;background:radial-gradient(circle at 50% 0%,#50285e,#1d1633 70%);border:3px solid #ba8dff;box-shadow:0 0 0 200vw #000000bd,0 0 100px #ab7df96e,inset 0 0 100px #b279ff2d;display:flex;justify-content:center;align-items:center;flex-direction:column;gap:2%;border-radius:3vw;z-index:6;text-align:center}.winner-trophy{font-size:clamp(40px,8vw,160px);filter:drop-shadow(0 0 25px #ffcf7c70)}.winner-banner small{font:800 clamp(12px,1.7vw,36px) Arial;color:#cbb0ff;letter-spacing:3px}.winner-banner strong{font-size:clamp(25px,5vw,105px);max-width:90%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.winner-banner>span{font-size:clamp(14px,2vw,40px);color:#ffdca0}.winner-banner.appear{animation:pop .65s both}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-16px)}}@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes pop{0%{transform:scale(.65);opacity:0}80%{transform:scale(1.03);opacity:1}100%{transform:scale(1);opacity:1}}
@media(max-width:1040px){.dashboard-grid{grid-template-columns:1fr}.sidebar{display:grid;grid-template-columns:1fr 1fr;align-items:start}.sidebar .leaderboard-panel{grid-column:1/-1}.hero{padding:30px}.hero-art{min-height:230px}.arena-symbol{width:165px;height:165px;font-size:60px}.feed{grid-template-columns:1fr 1fr}}
@media(max-width:700px){.topbar{min-height:70px;padding:0 15px}.brand strong{font-size:15px}.brand small{font-size:7px}.brand-mark{width:36px;height:36px}.version,.small-button{display:none}.pill{font-size:10px}.shell{padding:15px}.hero{grid-template-columns:1fr;padding:27px 22px;min-height:auto}.hero h1{font-size:33px}.hero p{font-size:12px}.hero-art{display:none}.hero-actions .button{padding:11px 12px;font-size:11px}.stats{grid-template-columns:1fr 1fr;gap:10px;margin:13px 0}.stat{min-height:102px;padding:15px}.stat-number{font-size:26px}.stat-number.small{font-size:16px}.main-panel{padding:17px}.panel{border-radius:17px;padding:18px}.section-heading h2{font-size:20px}.modes{gap:7px}.mode{min-height:105px;border-radius:12px}.mode strong{font-size:11px}.mode-glyph{width:33px;height:33px;font-size:18px}.mode small{font-size:8px}.form-card{padding:13px}.form-heading{align-items:flex-start;flex-direction:column;gap:4px}.option-grid{gap:7px}.option-grid label{gap:4px;padding-right:7px}.option-grid input{font-size:11px}.button{font-size:12px;padding:10px 13px}.preview-box{margin-top:14px}.sidebar{display:flex;align-items:stretch}.feed{grid-template-columns:1fr}.footer{flex-direction:column;gap:3px}.overlay-center{gap:1.4vh}.overlay-stage{min-height:0}.overlay-center h1{font-size:clamp(16px,4vw,30px)}.overlay-center p{font-size:clamp(10px,2.3vw,18px)}.overlay-choices{width:94%;gap:1vw}.overlay-choices>div{border-radius:5px;padding:1.5vh 1.5vw}.overlay-choices span{font-size:clamp(9px,2.2vw,15px)}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important}}

/* Arabic question library controls */
.panel-inset{margin:18px 0 16px;padding:19px;border:1px solid #504065;border-radius:16px;background:linear-gradient(115deg,#1d1932,#151626)}
.bank-header{display:flex;justify-content:space-between;align-items:center;gap:12px}
.bank-header h3{font-size:17px;margin:4px 0 6px;color:#fff}
.bank-header p{margin:0;color:#a7a0ba;font-size:11px;line-height:1.8}
.bank-eyebrow{color:#b9a1e7;font:800 9px Arial;letter-spacing:1.5px}
.bank-header>strong{background:#372a52;color:#e0caff;border:1px solid #684992;padding:9px 12px;border-radius:10px;white-space:nowrap;font:800 12px Arial}
.bank-controls{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:14px}
.bank-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:13px}
.bank-actions .button{flex:1}
.bank-bottom{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:14px;font-size:11px;color:#a79bb5}
.bank-source{font-size:11px;color:#bcb1d0;margin-top:10px;overflow-wrap:anywhere}
.bank-source a{color:#c6a6fd}.bank-controls select{width:100%;min-width:0}.bank-bottom .text-link{white-space:nowrap}
@media(max-width:700px){.panel-inset{padding:13px}.bank-header{align-items:flex-start}.bank-header>strong{font-size:10px}.bank-controls{gap:8px}.bank-actions{flex-direction:column}.bank-actions .button{width:100%;flex:none}.bank-bottom{align-items:flex-start;flex-wrap:wrap}}
