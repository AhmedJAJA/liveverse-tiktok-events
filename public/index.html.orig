<!doctype html>
<html lang="ar" dir="rtl">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#0b0d14"><meta name="description" content="منصة فعاليات البث المباشر - تفاعل مع جمهور TikTok LIVE عبر الألعاب والأسئلة والتحديات."><title>LIVEVERSE — استوديو الفعاليات</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="/styles.css"></head>
<body>
<div class="ambient ambient-a"></div><div class="ambient ambient-b"></div>
<header class="topbar">
 <div class="brand"><span class="brand-mark">L<span class="brand-dot">●</span></span><div><strong>LIVEVERSE</strong><small>CREATOR STUDIO / استوديو الفعاليات</small></div></div>
 <div class="top-right"><span class="version">v0.2 • BETA</span><span id="networkBadge" class="pill"><span class="status-dot"></span>في وضع المعاينة</span><a class="small-button" href="/overlay" target="_blank" rel="noopener">شاشة العرض <span aria-hidden="true">↗</span></a></div>
</header>
<main class="shell">
 <section class="hero"><div><span class="eyebrow"><span class="spark">✦</span> منصة تفاعلية للبث المباشر</span><h1>حوّل المشاهدين إلى <em>لاعبين.</em></h1><p>أسئلة، تحديات، سباقات وعجلة حظ. كل تعليق يصنع لحظة جديدة في بثك.</p><div class="hero-actions"><a href="#studio" class="button primary">ابدأ إعداد الفعالية <span>←</span></a><a class="button subdued" href="/overlay" target="_blank" rel="noopener">فتح شاشة OBS <span>↗</span></a></div></div><div class="hero-art" aria-hidden="true"><span class="orb orb-1">✦</span><span class="orb orb-2">★</span><div class="arena-symbol">LV<span class="spark-mini">✦</span></div><div class="floating-tag tag-top">LIVE <span class="red-dot">●</span></div><div class="floating-tag tag-bottom">🏆 +5 POINTS</div></div></section>
 <section class="stats" aria-label="إحصائيات البث"><div class="stat"><div class="stat-label">الحالة <span>●</span></div><div id="statusText" class="stat-number small">جاهز</div><div class="stat-foot">الفعالية الحالية</div></div><div class="stat"><div class="stat-label">المشاركون <span>◈</span></div><div id="totalPlayers" class="stat-number">0</div><div class="stat-foot">خلال الجلسة</div></div><div class="stat"><div class="stat-label">رقم الجولة <span>↻</span></div><div id="roundNumber" class="stat-number">00</div><div class="stat-foot">الجولات المنفذة</div></div><div class="stat"><div class="stat-label">الاتصال <span>↗</span></div><div id="liveStatus" class="stat-number small">غير متصل</div><div class="stat-foot" id="liveSubtitle">TikTok LIVE</div></div></section>
 <div class="dashboard-grid" id="studio">
 <section class="panel main-panel"><div class="section-heading"><div><span class="overline">01 / EVENT CONTROL</span><h2>استوديو الألعاب</h2><p>اختر نوع الفعالية وجهّز الجولة التالية.</p></div><span class="section-icon">✦</span></div>
 <div class="modes" id="modes"><button class="mode is-selected" data-mode="quiz"><span class="mode-glyph violet">?</span><strong>الأسئلة</strong><small>Quiz</small></button><button class="mode" data-mode="guess"><span class="mode-glyph blue">◈</span><strong>التخمين</strong><small>Guess</small></button><button class="mode" data-mode="race"><span class="mode-glyph orange">⚡</span><strong>السباق</strong><small>Race</small></button><button class="mode" data-mode="wheel"><span class="mode-glyph pink">✺</span><strong>العجلة</strong><small>Wheel</small></button></div>
 <div class="question-bank panel-inset" id="questionBankPanel">
  <div class="bank-header"><div><div class="bank-eyebrow">✦ QUESTION LIBRARY</div><h3>بنك الأسئلة العربي</h3><p>أسئلة جاهزة مع مجالات ومستويات مختلفة، ومنع التكرار خلال الجلسة.</p></div><strong id="bankCount">— سؤال</strong></div>
  <div class="bank-controls">
    <label class="field"><span>المجال</span><select id="bankCategory"><option value="all">كل المجالات</option><option value="general">معلومات عامة</option><option value="football">كرة القدم</option><option value="anime">الأنمي</option><option value="gaming">الألعاب</option><option value="history">التاريخ</option><option value="geography">الجغرافيا</option><option value="science">العلوم والكيمياء</option><option value="technology">التقنية</option><option value="math">رياضيات وألغاز</option></select></label>
    <label class="field"><span>مستوى الصعوبة</span><select id="bankDifficulty"><option value="all">كل المستويات</option><option value="easy">سهل</option><option value="medium">متوسط</option><option value="hard">صعب</option><option value="impossible">مستحيل</option></select></label>
  </div>
  <div class="bank-actions"><button class="button subdued" type="button" id="loadQuestionButton">🎲 تحميل سؤال</button><button class="button primary" type="button" id="playQuestionButton">▶ سؤال عشوائي وابدأ</button></div>
  <div class="bank-bottom"><span id="bankRemaining">فعّل رمز الإدارة لعرض إحصائيات الأسئلة.</span><button id="bankResetButton" type="button" class="text-link">إعادة ضبط التكرار</button></div>
  <div id="bankSource" class="bank-source" hidden></div>
 </div>
 <div class="form-card"><form id="gameForm"><div class="form-heading"><h3>إعداد الجولة</h3><span id="modeHint">أول إجابة صحيحة تفوز بـ 5 نقاط</span></div><label class="field"><span>عنوان الجولة</span><input name="title" id="gameTitle" maxlength="80" value="تحدي المعلومات" required placeholder="عنوان يظهر في شاشة البث"></label><div id="questionWrap"><label class="field"><span>السؤال أو التحدي</span><input name="prompt" id="gamePrompt" maxlength="200" value="ما هي عاصمة المملكة العربية السعودية؟" placeholder="اكتب السؤال هنا"></label></div><div id="optionsWrap" class="options-wrap"><span class="field-caption">الخيارات <small>اكتب الإجابات الأربعة</small></span><div class="option-grid"><label><span>A / 1</span><input id="opt1" maxlength="80" value="الرياض" aria-label="الخيار الأول"></label><label><span>B / 2</span><input id="opt2" maxlength="80" value="جدة" aria-label="الخيار الثاني"></label><label><span>C / 3</span><input id="opt3" maxlength="80" value="الدمام" aria-label="الخيار الثالث"></label><label><span>D / 4</span><input id="opt4" maxlength="80" value="مكة" aria-label="الخيار الرابع"></label></div></div><div class="dual-fields"><label class="field" id="answerWrap"><span id="answerLabel">الإجابة الصحيحة</span><select id="gameAnswer"><option value="1">A — الخيار الأول</option><option value="2">B — الخيار الثاني</option><option value="3">C — الخيار الثالث</option><option value="4">D — الخيار الرابع</option></select></label><label class="field" id="targetWrap" hidden><span>خط النهاية (عدد الحركات)</span><input type="number" id="gameTarget" min="3" max="100" value="12"></label></div><div class="form-actions"><button class="button primary" type="submit">حفظ الإعدادات <span>↗</span></button><button id="startButton" class="button success" type="button">▶ بدء الجولة</button><button id="stopButton" class="button outline" type="button">إيقاف</button><button id="drawButton" class="button accent" type="button" hidden>✺ اختيار الفائز</button></div></form><div class="helper" id="instruction">المشاهد يكتب رقم الإجابة في التعليقات: 1 أو 2 أو 3 أو 4</div></div>
 <div class="preview-box"><div class="preview-head"><span><span class="dot-glow"></span> معاينة شاشة البث</span><a href="/overlay" target="_blank" rel="noopener">فتح بحجم كامل ↗</a></div><iframe src="/overlay" title="معاينة الشاشة" loading="lazy"></iframe></div>
 </section>
 <aside class="sidebar"><section class="panel auth-panel"><div class="section-heading compact"><div><span class="overline">02 / LIVE CONNECTION</span><h2>ربط تيك توك</h2></div><span class="section-icon">⌁</span></div><label class="field"><span>رمز إدارة الموقع</span><input id="adminToken" type="password" autocomplete="off" placeholder="ADMIN_TOKEN" aria-label="رمز إدارة الموقع"></label><button class="button subdued full" id="verifyButton" type="button">تفعيل صلاحية الإدارة</button><div id="authLabel" class="inline-message">افتح سجل تشغيل السيرفر المحلي للحصول على الرمز أو اضبطه في Render.</div><hr><label class="field"><span>اسم مستخدم البث</span><div class="input-with-prefix"><span>@</span><input id="tiktokUser" placeholder="your_username" dir="ltr" maxlength="30" autocomplete="off"></div></label><div class="connection-actions"><button id="connectButton" class="button primary" type="button">اتصال بالبث</button><button id="disconnectButton" class="button outline" type="button">فصل</button></div><div class="inline-message" id="connectionDetail">يمكنك تجربة الألعاب بدون بث باستخدام محاكاة التعليقات أدناه.</div></section>
 <section class="panel test-panel"><div class="section-heading compact"><div><span class="overline">03 / TEST ROOM</span><h2>تجربة التعليقات</h2></div><span class="section-icon">⚙</span></div><p class="section-desc">اختبر اللعبة قبل البث. تضاف التعليقات كما لو جاءت من مشاهد حقيقي.</p><label class="field"><span>اسم المشاهد التجريبي</span><input id="demoName" value="Player_01" maxlength="32"></label><label class="field"><span>التعليق</span><input id="demoMessage" placeholder="مثال: 1 أو !join أو !go" maxlength="160"></label><button class="button subdued full" id="simulateButton" type="button">إرسال تعليق تجريبي ↗</button></section>
 <section class="panel leaderboard-panel"><div class="section-heading compact"><div><span class="overline">04 / TOP PLAYERS</span><h2>لوحة المتصدرين</h2></div><button id="resetScoresButton" type="button" class="text-link" title="حذف جميع النقاط">تصفير</button></div><div id="leaderboard" class="leaderboard"><div class="empty">لم يحصل أحد على نقاط بعد.</div></div></section></aside>
 </div>
 <section class="panel activity-panel"><div class="section-heading compact"><div><span class="overline">05 / LIVE FEED</span><h2>التعليقات الأخيرة</h2></div><span class="stream-tag"><span>●</span> LIVE ACTIVITY</span></div><div id="chatFeed" class="feed"><div class="empty">التعليقات ستظهر هنا عند الاتصال أو المحاكاة.</div></div></section>
 <footer class="footer"><span>LIVEVERSE STUDIO <span class="muted">© 2026</span></span><span>منصة ألعاب للبث المباشر • نسخة تجريبية مستقلة عن TikTok</span></footer>
</main>
<div id="toast" class="toast" role="status" aria-live="polite"></div>
<script type="module" src="/app.js"></script>
</body></html>
